# A flake cannot see untracked files, so anything here is INVISIBLE to the
# build. Keep this list nearly empty on purpose.

# Deploy target artifacts that must never come back from /etc/nixos
/etc-nixos.backup-*

# Generated per machine by nixos-generate-config. Carries real partition
# UUIDs, so it must never be committed. deploy.sh places the live one in
# /etc/nixos and configuration.nix imports it conditionally.
hardware-configuration.nix

# Editor and OS noise
*.swp
*~
.DS_Store
result
result-*
